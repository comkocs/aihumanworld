[Unit]
Description=AI 人间 slice(与 panedesk-ci、user-1000 隔离)

[Slice]
# 本 slice 跑 aihw.service 与本服务专用的 PostgreSQL 实例;不进 panedesk-ci.slice 与 user-1000.slice。
# CPU / IO 权重低于 Panedesk:默认 100,这里压到 50;Panedesk 侧保持默认或更高即可。
CPUWeight=50
IOWeight=50
# 硬上限 4G。OOM 时只杀本 slice 内进程,不波及同机其他服务。
MemoryMax=4G
MemoryHigh=3G
# 整个 slice 合计 CPU 上限 4 核(服务 + 专用库一起算)。
# 部分 systemd 版本会忽略 CPUAccounting= 并告警,不写;CPU 上限靠 CPUQuota 生效(Panedesk 上机 11-06 实测)。
CPUQuota=400%
MemoryAccounting=yes
IOAccounting=yes
