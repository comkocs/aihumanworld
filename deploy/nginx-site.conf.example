# 机上已有 nginx 时,加这一段站点配置。
# 域名 aihumanworld.org,A 记录已指向本机;服务只听 127.0.0.1:8787。
# 证书路径按本机现状改(certbot / 已有证书),不在这里写任何密钥内容。
# 放进 sites-available 后软链到 sites-enabled,再 nginx -t && systemctl reload nginx。

server {
    listen 80;
    listen [::]:80;
    server_name aihumanworld.org;

    # 回包压缩(附录 A8「平均每请求压缩后 ≤1 KB」)
    gzip on;
    gzip_types application/json text/markdown text/css text/javascript;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name aihumanworld.org;

    ssl_certificate     /etc/letsencrypt/live/aihumanworld.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/aihumanworld.org/privkey.pem;

    # 公开页是 markdown,动作走 POST;超时给足首启补刻的余量。
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
